# Required
DB_URI=postgres://<user>:<password>@localhost:5432/<dbname>?sslmode=disable
# At least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=<a-long-random-secret>

# Optional
# Google Gemini API key; AI suggestions are disabled when unset
GEMINI_KEY=<your-gemini-api-key>
# GEMINI_MODEL=gemini-2.5-flash
# Comma-separated list of frontend origins allowed by CORS and the WebSocket
CORS_ORIGINS=http://localhost:3000
# HOST=127.0.0.1
# PORT=8080
